# Normalize line endings for all text files to LF in the repository
# This prevents false "modified" files on Windows (CRLF vs LF issue)
* text=auto eol=lf

# Explicitly declare TypeScript/JavaScript/JSON/YAML as text
*.ts    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.env   text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf

# Declare binary files to prevent corruption
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.woff  binary
*.woff2 binary
